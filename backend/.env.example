# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 절대 커밋하지 않기)

# MySQL 접속 정보 (docker-compose 기본값과 같음)
DATABASE_URL=mysql+pymysql://wear:wear1234@localhost:3306/wear?charset=utf8mb4

# JWT 서명 키 — 아무 긴 랜덤 문자열 (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# 프론트 개발 서버 주소 (CORS 허용)
CORS_ORIGINS=http://localhost:5173

# 업로드한 옷 사진 저장 폴더
UPLOAD_DIR=uploads

# --- 기능1: AI 옷장 등록 ---
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 키
GEMINI_API_KEY=
# 사진 분석 모델 (무료 등급에서 쓸 수 있는 모델로)
GEMINI_MODEL=gemini-3.8-flash
# 주 모델이 붐빌 때(503) 대신 쓸 모델. 비우면 사용 안 함
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# 모델이 답하기 전 '생각'하는 정도. 낮을수록 빠름 (minimal/low/medium/high, 비우면 기본값)
GEMINI_THINKING=minimal
# 배경 제거 (requirements-bg.txt 설치 필요). 끄려면 false
BG_REMOVAL=true
BG_MODEL=u2net

# --- 이후 단계에서 사용 ---
# WEATHER_API_KEY=
