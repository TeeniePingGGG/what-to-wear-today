  "components": {
    "schemas": {
      "AnalyzedItem": {
        "properties": {
          "image_url": {
            "type": "string",
            "title": "Image Url",
            "description": "옷 한 벌만 잘라 배경을 지운 이미지"
          },
          "background_removed": {
            "type": "boolean",
            "title": "Background Removed"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClothingAnalysis"
              },
              {
                "type": "null"
              }
            ]
          },
          "ai_raw": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Raw",
            "description": "저장할 때 ai_analysis 로 그대로 보내 주세요"
          }
        },
        "type": "object",
        "required": [
          "image_url",
          "background_removed",
          "analysis",
          "ai_raw"
        ],
        "title": "AnalyzedItem",
        "description": "잘라내고 배경 제거한 옷 한 벌 + AI 분석 결과."
      },
      "Body_analyze_api_clothes_analyze_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "옷 사진 (jpg/png/webp, 10MB 이하). 여러 벌을 같이 찍어도 됨"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_analyze_api_clothes_analyze_post"
      },
      "Category": {
        "type": "string",
        "enum": [
          "TOP",
          "BOTTOM",
          "OUTER",
          "DRESS",
          "SHOES",
          "BAG",
          "ACCESSORY"
        ],
        "title": "Category"
      },
      "ClothingAnalysis": {
        "properties": {
          "is_clothing": {
            "type": "boolean",
            "title": "Is Clothing"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "sub_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub Category"
          },
          "color_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Name"
          },
          "color_hex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Hex"
          },
          "seasons": {
            "items": {
              "$ref": "#/components/schemas/Season"
            },
            "type": "array",
            "title": "Seasons",
            "default": []
          },
          "styles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Styles",
            "default": []
          },
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "warmth_level": {
            "type": "integer",
            "title": "Warmth Level",
            "default": 3
          },
          "is_waterproof": {
            "type": "boolean",
            "title": "Is Waterproof",
            "default": false
          },
          "low_confidence_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Low Confidence Fields",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "is_clothing",
          "name",
          "category"
        ],
        "title": "ClothingAnalysis",
        "description": "Vision AI 가 돌려주는 형식 (Gemini response_schema 로도 사용)."
      },
      "ClothingBulkCreate": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ClothingCreate"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ClothingBulkCreate"
      },
      "ClothingCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "sub_category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub Category"
          },
          "color_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Name"
          },
          "color_hex": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Hex"
          },
          "seasons": {
            "items": {
              "$ref": "#/components/schemas/Season"
            },
            "type": "array",
            "title": "Seasons",
            "default": []
          },
          "styles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Styles",
            "default": []
          },
          "material": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "warmth_level": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Warmth Level",
            "default": 3
          },
          "is_waterproof": {
            "type": "boolean",
            "title": "Is Waterproof",
            "default": false
          },
          "memo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Memo"
          },
          "image_url": {
            "type": "string",
            "maxLength": 500,
            "title": "Image Url",
            "description": "analyze 응답의 image_url"
          },
          "original_image_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Image Url"
          },
          "ai_analysis": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Analysis",
            "description": "analyze 응답의 ai_raw (수정 전 AI 원본)"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category",
          "image_url"
        ],
        "title": "ClothingCreate",
        "description": "AI 분석(/clothes/analyze) 후 사용자가 검수한 값으로 저장."
      },
      "ClothingOut": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "sub_category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub Category"
          },
          "color_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Name"
          },
          "color_hex": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Hex"
          },
          "seasons": {
            "items": {
              "$ref": "#/components/schemas/Season"
            },
            "type": "array",
            "title": "Seasons",
            "default": []
          },
          "styles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Styles",
            "default": []
          },
          "material": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "warmth_level": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Warmth Level",
            "default": 3
          },
          "is_waterproof": {
            "type": "boolean",
            "title": "Is Waterproof",
            "default": false
          },
          "memo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Memo"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          },
          "original_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Image Url"
          },
          "ai_analysis": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Analysis"
          },
          "is_verified": {
            "type": "boolean",
            "title": "Is Verified"
